{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types",
      "vitest/globals",
      "node"
    ]
  },
  "include": [
    "worker/**/*.ts",
    "tests/**/*.ts",
    "browser-e2e.vitest.config.ts",
    "vitest.config.ts",
    "worker-configuration.d.ts",
    "../src/shared/cloudSync.ts"
  ]
}
