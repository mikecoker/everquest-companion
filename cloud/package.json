{
  "name": "@eq-legends/cloud-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "vite build --config activity/vite.config.ts",
    "deploy:dry": "wrangler deploy --dry-run --config wrangler.jsonc",
    "dev:activity": "vite --config activity/vite.config.ts",
    "dev:worker": "wrangler dev --config wrangler.jsonc",
    "test": "npm run test:worker && npm run test:activity && npm run test:browser",
    "test:activity": "vitest run --config activity/vitest.config.ts",
    "test:browser": "npm run build && vitest run --config browser-e2e.vitest.config.ts --maxWorkers=1",
    "test:worker": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p activity/tsconfig.json --noEmit && tsc -p browser-tsconfig.json --noEmit"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "2.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "@cloudflare/workers-types": "5.20260808.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "29.1.1",
    "playwright-core": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  }
}
